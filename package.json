    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.67.0",
